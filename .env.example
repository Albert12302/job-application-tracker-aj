# Copy to .env.local (gitignored) and fill from the output of `npx supabase start`.
# Vite exposes every VITE_-prefixed var to the browser bundle, so only values that
# are safe in public belong here (SPEC §7.4).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Commit sha, attached to error reports (SPEC §7.7). CI sets it; blank locally is fine.
VITE_RELEASE=

# NOT HERE, EVER:
#   SUPABASE_SERVICE_ROLE_KEY   bypasses RLS entirely. Lives only in the sign-in edge
#                               function's runtime, set with `supabase secrets set`.
#   SIGN_IN_HASH_PEPPER         same — edge function only.
# A service role key in a VITE_ var is in the bundle, and a bundle is public.
